{
  "servers": {
    "shadcn": { "command": "npx", "args": ["shadcn@latest", "mcp"] },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--headless",
        "--storage-state=${userHome}/.config/playwright-mcp-auth.json"
      ]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }
  },
  "inputs": []
}
