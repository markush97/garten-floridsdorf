{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "always"
  },
  "files.associations": {
    "*.css": "tailwindcss",
    "biome.json": "jsonc"
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/routeTree.gen.ts": true
  },
  "material-icon-theme.files.associations": {
    "*.instructions.md": "copilot",
    "*.config.service.ts": "settings",
    "*.entity.ts": "database",
    "*.interface.ts": "typescript-def",
    "*.helper.ts": "lib",
    "*.healthcheck.ts": "heart",
    "*.strategy.ts": "key",
    "*.e2e-spec.ts": "test-ts",
    "*.store.tsx": "store",
    "*.processor.ts": "middleware",
    "*.registry.ts": "lib",
    "*.mti-exception.ts": "error",
    "*.api.service.ts": "http",
    "*.mapper.ts": "pipe",
    "*.validator.ts": "verify",
    "*.repository.ts": "database",
    "version.ts": "changelog",
    "router.tsx": "routing",
    "mikro-orm.config.ts": "database"
  },
  "material-icon-theme.folders.associations": {
    "instructions": "markdown",
    "guards": "middleware",
    "decorators": "middleware",
    "strategies": "middleware",
    "entities": "database",
    "dto": "contract",
    "fixtures": "mock",
    "testutils": "test",
    "constants": "constant",
    "helpers": "helper",
    "interfaces": "interface",
    "templates": "template",
    "services": "server",
    "caching": "resource",
    "queue": "queue",
    "email": "mail",
    "logging": "log",
    "states": "context",
    "hooks": "hook",
    "routes": "routes",
    "api": "api",
    "integrations": "plugin",
    "styles": "css",
    "types": "typescript",
    "shared": "shared",
    "errorhandling": "error",
    "healthcheck": "guard",
    "schedules": "event",
    "persistence": "database",
    "tasktypes": "job",
    "configs": "config"
  },
  "material-icon-theme.languages.associations": {
    "dotenv": "tune"
  },
  "search.exclude": {
    "**/.tsbuildinfo": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/routeTree.gen.ts": true
  },
  "window.title": "${dirty}beet${separator}${rootName}",
  "workbench.sideBar.location": "right",
  "workbench.editor.customLabels.patterns": {
    "**/biome.json": "${dirname} - biome.json",
    "**/package.json": "${dirname} - package.json",
    "**/tsconfig.json": "${dirname} - tsconfig.json"
  },
  // Mirrors commitlint.config.ts scope-enum — do NOT add scopes here without adding them there first.
  // User-facing scopes (appear in in-app changelog) listed first, then internal-only.
  "conventionalCommits.scopes": [
    "auth",
    "certificates",
    "chat",
    "comments",
    "customers",
    "dashboard",
    "devices",
    "dns",
    "email",
    "events",
    "filemanagement",
    "help",
    "imaging",
    "integrations",
    "iso-images",
    "jobs",
    "mcp",
    "network",
    "notifications",
    "oncall",
    "passwordgenerator",
    "permissions",
    "reports",
    "schedule",
    "search",
    "tasks",
    "tickets",
    "time",
    "todos",
    "ui",
    "unifi",
    "users",
    "webhooks",
    "backend",
    "build",
    "ci",
    "config",
    "contracts",
    "core",
    "deps",
    "docs",
    "emails",
    "frontend",
    "ninja",
    "ninjarmm",
    "persistence",
    "refactor",
    "release",
    "security",
    "swa",
    "tests"
  ],
  "chat.tools.terminal.autoApprove": {
    "npx biome": true
  }
}
