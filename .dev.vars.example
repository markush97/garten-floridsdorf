# Local-only secrets for `pnpm dev`. Picked up automatically by
# @cloudflare/vite-plugin and wrangler. Copy this file to `.dev.vars`
# and adjust the values. Do NOT commit `.dev.vars`.

# Bootstrap admin login (username "admin") — only used until the first
# real admin account is invited and activated. Remove once you have one.
ADMIN_PASSWORD = "changeme"
JWT_SECRET = "local-dev-secret-please-change"

# Outbound e-mail is delivered through the self-hosted `smtprelay`
# container running next to Mailcow (see docs/smtp-relay.md).
# Without SMTP_RELAY_URL the Worker logs the mail body to the
# console instead of sending (fine for local dev).
SMTP_RELAY_URL = "https://mail-relay.beetbewegung.at"
SMTP_RELAY_TOKEN = "change-me-long-random-string"
# Optional override for the From address; defaults to anmeldung@beetbewegung.at.
EMAIL_FROM = "Bewegung im Grünen in Jedlesee <anmeldung@beetbewegung.at>"
