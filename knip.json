{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "functions/api/[[path]].ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "functions/**/*.ts", "e2e/**/*.ts"],
  "ignore": ["src/lib/api-client.ts", "src/ui/**"],
  "exclude": ["exports", "nsExports", "types", "nsTypes"],
  "ignoreDependencies": [
    "@fontsource-variable/fraunces",
    "@fontsource-variable/inter",
    "@playwright/test",
    "@tanstack/react-form",
    "react-hook-form",
    "shadcn",
    "sharp",
    "tailwindcss",
    "tw-animate-css"
  ]
}
